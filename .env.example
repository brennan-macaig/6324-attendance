# Copy to .env.local for local development. On Vercel, set these in
# Project -> Settings -> Environment Variables.

# --- Database (required) -----------------------------------------------------
# Neon pooled connection string (Neon console -> Connect). Used by the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Optional: Neon *direct* (unpooled) URL, preferred by migrations/seed.
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Local alternatives (see README):
#   Docker + Neon HTTP proxy: DATABASE_URL="postgres://postgres:postgres@db.localtest.me:5432/main"
#   Zero-install embedded demo DB (dev only): DATABASE_URL="pglite://.data/pglite"

# --- Auth.js (required) ------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only needed outside Vercel if the app is behind a proxy with a different host:
# AUTH_URL="https://attendance.example.org"

# --- Check-in tokens (required) ----------------------------------------------
# Random string, >= 32 chars. Signs the rotating QR tokens and scan-proof cookies.
# Generate with: openssl rand -base64 48
CHECKIN_SECRET=""
# Public base URL encoded in QR codes. On Vercel defaults to the production domain.
APP_URL="http://localhost:3000"

# --- Access policy (optional) ------------------------------------------------
# Only allow Google accounts from this domain, e.g. "school.org"
ALLOWED_EMAIL_DOMAIN=""
# Comma-separated emails that are always admins (bootstraps the first admin)
ADMIN_EMAILS=""
# "true" = only emails already on the roster (or in ADMIN_EMAILS) may sign in.
# Otherwise unknown users are auto-created as students on first sign-in.
REQUIRE_ROSTER="false"

# --- Presence signals (optional) ---------------------------------------------
# Comma-separated CIDRs for the school network's public egress IPs.
# Check-ins from outside these get the `off_network` flag (never blocked).
SCHOOL_IP_RANGES=""

# --- Daily auto check-out (optional) -----------------------------------------
# Anyone still checked in at this time (24h, TEAM_TIMEZONE) is checked out at
# exactly this time, and new check-ins are refused until the next day.
DAILY_CHECKOUT_TIME="21:00"
# Protects /api/cron/auto-checkout (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- Display (optional) ------------------------------------------------------
TEAM_TIMEZONE="America/New_York"
TEAM_NAME="FRC Team 0000"
